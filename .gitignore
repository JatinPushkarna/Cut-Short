node_modules
dist
.DS_Store
.env
__pycache__

# Ignore the output video from Git but not videos you import into src/.
out

# Every cutshort project (objective.md, campaign docs, script, transcripts,
# media) lives under public/Projects/<slug>/ -- Remotion's staticFile() only
# resolves inside public/, so that's also where the plan/reference data
# ends up. All of it is user/generated data, not tool source code.
public

# Every cutshort project's composition code (day-by-day clips, shared
# components/typography) lives under this one root -- see
# `design build`'s prompt in cli/commands/design-build.ts, which writes new
# compositions to src/projects-local/<slug>/. One generic rule covers every
# current and future project; nothing here should ever need a project's own
# name added to it again.
src/projects-local/

# Local composition preview registry -- whatever project(s) you're actively
# previewing get registered here instead of in the committed src/Root.tsx.
# Auto-created from src/Root.local.tsx.example on first `npm run dev`/`build`
# (see scripts/ensure-root-local.js) if it doesn't exist yet. This is what
# stops a project-specific import from ever ending up in a real commit again
# -- src/Root.tsx stays generic because there's nowhere for it to drift to.
src/Root.local.tsx

# Project-specific Claude/Codex instructions -- CLAUDE.md/AGENTS.md (generic,
# committed) @import this when present. Campaign/project details belong here
# instead, since those files stay generic on purpose.
CLAUDE.local.md
Codex.local.md
ARCHITECTURE-REVIEW.local.md
IMPROVEMENTS.local.md
REFLECTIONS.local.md

# Campaign-specific skills -- contain real campaign strategy/performance
# data (promo-copywriting) or Lie-Detector-only workflow steps
# (video-editing), not generic cutshort tool guidance. TODO: distill any
# genuinely generic technique out of these into the public CLAUDE.md/AGENTS.md
# or a real skill, then these can go back to being local-only notes.
.claude/skills/video-editing/
.claude/skills/promo-copywriting/
.agents/skills/video-editing/
.agents/skills/promo-copywriting/
.remotion-bin/

# Verification/debug frames (contact sheets, cut-boundary checks) belong
# under public/Projects/<slug>/.frame-check/ (already covered by the
# `public` rule above) or the scratchpad, never the repo root -- but a
# root-level one has happened by mistake before and would leak real
# campaign frames (actors' faces, unreleased footage) into public git
# history. This is a backstop, not the intended location.
/.frame-check/
